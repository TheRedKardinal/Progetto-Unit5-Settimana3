# Copia questo file in BE/.env e compila i valori. BE/.env NON va committato.

DB_URL=jdbc:postgresql://localhost:5432/salone
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Stringa casuale di almeno 32 caratteri
JWT_SECRET=
JWT_EXPIRATION=PT24H

# Credenziali SMTP della inbox Mailtrap (Email Testing > Inbox > SMTP)
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@salone-auto.it

FRONTEND_URL=http://localhost:5173

AUTODEV_API_KEY=

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@salone-auto.it
ADMIN_PASSWORD=
